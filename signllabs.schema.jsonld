    {
      "@type": "DefinedTerm",
      "@id": "https://signllabs.ai/#ai-signaling",
      "name": "AI Signaling",
      "alternateName": [
        "AI signaling",
        "AI Signalling"
      ],
      "termCode": "ai-signaling",
      "description": "AI Signaling is the practice of engineering how answer engines understand, trust and recommend a brand. Answer engines do not rank pages: they synthesize a single answer and name a few brands. AI Signaling is the discipline of becoming one of those names. It is distinct from SEO, which earns a ranking on a page of links, and from answer engine optimization (AEO), which earns the snippet an answer engine reads back. AI Signaling earns the recommendation itself. Roughly 82 to 84 percent of AI citations trace to earned and third-party media, while brand-owned pages account for only 5 to 10 percent, so the work is led by earned media rather than owned content. The term and its measurement standard were created by SignlLabs, the AI Signaling practice of Global Communication Works (GCW).",
      "inDefinedTermSet": {
        "@id": "https://signllabs.ai/#standard"
      },
      "creator": {
        "@id": "https://signllabs.ai/#org"
      },
      "url": "https://signllabs.ai/#what",
      "subjectOf": {
        "@id": "https://signllabs.ai/#whitepaper"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://signllabs.ai/#answer-engine",
      "name": "Answer engine",
      "description": "An AI system that answers a question directly rather than returning a page of links, and names a small number of brands in that answer. The five that matter commercially are ChatGPT, Google Gemini, Claude, Microsoft Copilot and Perplexity.",
      "inDefinedTermSet": {
        "@id": "https://signllabs.ai/#standard"
      },
      "creator": {
        "@id": "https://signllabs.ai/#org"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://signllabs.ai/#query-fan-out",
      "name": "Query fan-out",
      "description": "The mechanic by which an answer engine splits a single prompt into roughly five hidden research queries, researches each separately, then composes one answer from the sources it trusts across all of them. Query fan-out is why a brand cannot keyword its way into an AI answer.",
      "inDefinedTermSet": {
        "@id": "https://signllabs.ai/#standard"
      },
      "creator": {
        "@id": "https://signllabs.ai/#org"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://signllabs.ai/#share-of-authority",
      "name": "Share of authority",
      "description": "The proportion of citations a brand earns on the questions in its category, branded and non-branded, measured per answer engine and tracked week over week.",
      "inDefinedTermSet": {
        "@id": "https://signllabs.ai/#standard"
      },
      "creator": {
        "@id": "https://signllabs.ai/#org"
      }
    },
    {
      "@type": "DefinedTerm",
      "@id": "https://signllabs.ai/#mms",
      "name": "Maturity Method Score",
      "alternateName": [
        "MMS",
        "Signaling Maturity Score"
      ],
      "description": "A single 0 to 100 score of how recommendable a brand is to answer engines, produced by the Maturity Method from six weighted dimensions and measured separately on each of five answer engines.",
      "inDefinedTermSet": {
        "@id": "https://signllabs.ai/#standard"
      },
      "creator": {
        "@id": "https://signllabs.ai/#org"
      }
    },
