    {
      "@type": "DefinedTermSet",
      "@id": "https://signllabs.ai/#intent-framework",
      "name": "The Intent Category Framework",
      "description": "The ten buyer intent categories SignlLabs scores across the buyer journey, grouped into five stages: Awareness, Consideration, Evaluation, Decision and Authority. Because of query fan-out a brand is not scored on one question but across the whole journey.",
      "creator": {
        "@id": "https://signllabs.ai/#org"
      },
      "publisher": {
        "@id": "https://signllabs.ai/#org"
      },
      "hasDefinedTerm": [
        {
          "@type": "DefinedTerm",
          "name": "Discovery and Category",
          "description": "Whether the brand is named at all in the unbranded category answer.",
          "termCode": "awareness",
          "inDefinedTermSet": {
            "@id": "https://signllabs.ai/#intent-framework"
          }
        },
        {
          "@type": "DefinedTerm",
