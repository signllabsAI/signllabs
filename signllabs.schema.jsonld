        {
          "@type": "Question",
          "name": "What is the Maturity Method?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Maturity Method is a zero to one hundred methodology by Erika Hanafin Austria that scores how recommendable a brand is to AI across six dimensions and ten intent categories, measured on all five major engines."
          }
        },
        {
          "@type": "Question",
          "name": "How do you get cited by AI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fix the owned foundation with schema and clear answer blocks, then earn citations in the third-party sources AI retrieves from: review platforms, communities, and trusted press. Earned media drives roughly 82 to 84 percent of AI citations, while owned pages account for only 5 to 10 percent."
